# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.
#
# Three different consumers read these variables and they do NOT share a path:
#
#   [compose]  `docker compose` reads ./.env automatically — but ONLY to
#              substitute ${...} inside compose.yml / compose.dev.yml.
#   [app]      read by the server inside the container. A root .env does NOT
#              reach these on its own; add `env_file: .env` to the service, or
#              list them in its `environment:` block.
#   [tests]    read by node. The e2e scripts run in their own Playwright
#              container, so pass them explicitly:
#                  docker run --env-file .env ... node tests/e2e/<file>.mjs

# ---------------------------------------------------------------- [compose]
# Published port. Both compose files use it, and both publish on 127.0.0.1
# only. Set a different value to run the dev stack beside the prod one.
DBADMIN_PORT=3456

# Host directories bind-mounted for the SQLite file browser and export picker.
# DBADMIN_SQLITE_DIR=./data/sqlite
# DBADMIN_EXPORT_DIR=./data/exports

# -------------------------------------------------------------------- [app]
# Only take effect once the service carries them — see the [app] note above.
# DBADMIN_PAGE_SIZE=200
# DBADMIN_SCHEMA_TTL_MS=300000
# DBADMIN_POOL_IDLE_MS=60000
# DBADMIN_JOB_CONCURRENCY=2
# DBADMIN_JOB_RETENTION_DAYS=7
# DBADMIN_SSH_DIR=/home/node/.ssh

# ------------------------------------------------------------------ [tests]
# The account the e2e suite signs in as, and the saved connections it expects
# to find. Put the real names here — this file's copy stays out of git.
# APP_URL=http://app:3456
# DBADMIN_USER=demo
# DBADMIN_PASSWORD=
# DBADMIN_CONNECTIONS=Demo Postgres,Demo MySQL,Demo Redis
# DBADMIN_CONNECTION=Demo Postgres
# DBADMIN_DATABASE=demo_db
# DBADMIN_SCHEMA=public
# DBADMIN_TABLE=demo_table

# Engine endpoints for `npm test`. Defaults already match the ports that
# compose.dev.yml's `dbs` profile publishes, so these are only for CI or a
# non-standard setup.
# TEST_MYSQL_HOST=127.0.0.1
# TEST_MYSQL_PORT=13306
# TEST_MARIADB_HOST=127.0.0.1
# TEST_MARIADB_PORT=13307
# TEST_PG_HOST=127.0.0.1
# TEST_PG_PORT=15432
# TEST_REDIS_HOST=127.0.0.1
# TEST_REDIS_PORT=16379
# TEST_MONGO_HOST=127.0.0.1
# TEST_MONGO_PORT=17017
